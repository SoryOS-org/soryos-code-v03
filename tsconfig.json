{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@soryos/core": ["./packages/core/src"],
      "@soryos/core/*": ["./packages/core/src/*"],
      "@soryos/schema": ["./packages/schema/src"],
      "@soryos/schema/*": ["./packages/schema/src/*"],
      "@soryos/bus": ["./packages/bus/src"],
      "@soryos/bus/*": ["./packages/bus/src/*"],
      "@soryos/permissions": ["./packages/permissions/src"],
      "@soryos/permissions/*": ["./packages/permissions/src/*"],
      "@soryos/execution": ["./packages/execution/src"],
      "@soryos/execution/*": ["./packages/execution/src/*"],
      "@soryos/tool": ["./packages/tool/src"],
      "@soryos/tool/*": ["./packages/tool/src/*"],
      "@soryos/workspace": ["./packages/workspace/src"],
      "@soryos/workspace/*": ["./packages/workspace/src/*"],
      "@soryos/session": ["./packages/session/src"],
      "@soryos/session/*": ["./packages/session/src/*"],
      "@soryos/provider": ["./packages/provider/src"],
      "@soryos/provider/*": ["./packages/provider/src/*"],
      "@soryos/database": ["./packages/database/src"],
      "@soryos/database/*": ["./packages/database/src/*"],
      "@soryos/agent": ["./packages/agent/src"],
      "@soryos/agent/*": ["./packages/agent/src/*"]
    },
    "jsx": "preserve"
  },
  "exclude": ["node_modules", "dist"]
}
